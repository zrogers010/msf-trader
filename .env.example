# Copy to .env and fill in. Only the provider you use is required.

# Which cloud LLM provider to use for vision + reasoning: "openai" or "anthropic"
MSF_LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
# Vision-capable chat model
MSF_OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=
MSF_ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Databento (REAL /ES futures for the backtester; `fetch-es`).
# Free signup with credit: https://databento.com/
DATABENTO_API_KEY=

# Alpaca Market Data (free intraday for the backtester; `fetch-alpaca`).
# Free key + secret (no funding needed): https://alpaca.markets/
# These keys access data.alpaca.markets ONLY (not valid for trading).
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Alpaca PAPER TRADING (for `swing-plan --broker alpaca`).
# IMPORTANT: Generate SEPARATE paper trading keys at
#   https://app.alpaca.markets/ -> Paper Trading -> API keys
# Data-only keys (APCA_* above) will NOT work for paper trading (401 error).
# Default paper account starts at $100k virtual cash.
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET_KEY=

# Alpha Vantage (NOTE: intraday is now premium-only; daily/EOD still free).
# Free key: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=
