*.mp4
*.mov
*.mkv
*.avi
*.wav
*.mp3
*.m4a
*.jpg
*.jpeg
*.png
*.gif
*.npy
transcript.json
frames.json
visual_notes.json
notes.json
kb.jsonl

# Secrets
.env
*.key

# Runtime state + logs (paper account / position counters / daily run logs)
logs/
*.log

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
build/
dist/

# OS / editor
.DS_Store
.idea/
.vscode/
