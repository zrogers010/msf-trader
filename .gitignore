# ---------------------------------------------------------------------------
# PRIVACY: keep ALL course material and anything derived from it OUT of git.
# Only source code and sanitized examples should ever be committed.
# ---------------------------------------------------------------------------

# Course videos + everything extracted/derived from them
data/
# generated docs contain course content + filenames
docs/

# Real config holds the actual video filenames -> use config.example.yaml instead
config.yaml

